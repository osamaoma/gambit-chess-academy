# Optional: a free Lichess API token for the Opening Explorer.
#
# As of 2025 the Lichess opening-explorer endpoints require authentication.
# If you set a token here, the Explorer works for everyone with no per-user
# setup. If you leave it blank, each user can paste their own token in the UI.
#
# How to get one (free, ~30 seconds):
#   1. Log in to https://lichess.org (free account)
#   2. Open https://lichess.org/account/oauth/token/create?description=Gambit
#   3. Leave ALL scopes unchecked — none are needed for the explorer
#   4. Click Create, copy the token, paste it below
#
# Then rename this file to ".env" (or set LICHESS_TOKEN in your host's
# environment variables, e.g. Render → Environment).

LICHESS_TOKEN=
